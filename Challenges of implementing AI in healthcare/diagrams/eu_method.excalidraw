      "isDeleted": false,
      "boundElements": [],
      "updated": 1788158704221,
      "link": null,
      "locked": false,
      "text": "Specifies the liability that AI system\ndevelopers have when the used system\ncause harm. \n   Victims can claim compensation from\nmanufacturer\n    Victim has to prove that the defective\nproduct was responsible for the damage\n     ",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Specifies the liability that AI system developers have when the used system cause harm. \n   Victims can claim compensation from manufacturer\n    Victim has to prove that the defective product was responsible for the damage\n     ",
      "autoResize": false,
      "lineHeight": 1.35
    }
