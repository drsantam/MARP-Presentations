      "type": "text",
      "x": 715.2001953125,
      "y": 275.5,
      "width": 316.599609375,
      "height": 151.20000000000002,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
