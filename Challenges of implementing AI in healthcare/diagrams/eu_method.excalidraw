      "versionNonce": 1820902926,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788158108598,
      "link": null,
      "locked": false,
      "text": "Facilitates secondary use of electronic\nhealth data for research and innovation. It\nallows:\n   Patients become \"owners\" of data\n   They can \"opt-in\" to data sharing\n   Credentialed access to shared data\n   Universal EHR interoperability ",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Facilitates secondary use of electronic health data for research and innovation. It allows:\n   Patients become \"owners\" of data\n   They can \"opt-in\" to data sharing\n   Credentialed access to shared data\n   Universal EHR interoperability ",
      "autoResize": false,
      "lineHeight": 1.35
    },
